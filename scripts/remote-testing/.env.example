# Remote Testing Configuration
# Copy this file to .env and fill in your values

# VM IP Addresses
US_IP="your.us.vm.ip.here"
JP_IP="your.jp.vm.ip.here"

# SSH Configuration
SSH_KEY_PATH="/path/to/your/ssh/key"
SSH_USER="ubuntu"

# Contender Private Key (for funding and transactions)
PRIVATE_KEY="your_private_key_here"

# Grafana Configuration (optional)
ENABLE_GRAFANA=false
# GRAFANA_BASE_URL="https://your-grafana-instance.com/d/dashboard-id/dashboard-name"
# GRAFANA_PARAMS="orgId=1&var-network=your-network"

# Remote Paths (usually don't need to change these)
REMOTE_CONTENDER_PATH="~/contender"
REMOTE_POST_PROCESSING_PATH="~/contender/post-processing"
